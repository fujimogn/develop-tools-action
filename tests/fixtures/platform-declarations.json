{
  "cases": [
    {
      "name": "linux",
      "manifest": {
        "platforms": [
          "linux"
        ],
        "release": {
          "preflightWorkflow": "ci.yml"
        }
      },
      "expect": {
        "platforms": [
          "linux"
        ]
      }
    },
    {
      "name": "valid-linux-macos",
      "manifest": {
        "integrationBranch": "develop",
        "platforms": [
          "linux",
          "macos"
        ],
        "platformCheck": {
          "cargoWorkspace": "tools",
          "bun": true,
          "setup": "./bin/ci-install --frozen-lockfile"
        },
        "release": {
          "preflightWorkflow": "ci.yml",
          "versionFiles": [
            {
              "path": "tools/Cargo.toml",
              "kind": "cargo-workspace"
            }
          ]
        }
      },
      "expect": {
        "platforms": [
          "linux",
          "macos"
        ],
        "check": {
          "cargoWorkspaces": [
            "tools"
          ],
          "bun": true,
          "setup": "./bin/ci-install --frozen-lockfile",
          "runIgnored": null
        }
      }
    },
    {
      "name": "linux-macos-windows",
      "manifest": {
        "platforms": [
          "windows",
          "linux",
          "macos"
        ],
        "platformCheck": {
          "cargoWorkspace": "packages/cli"
        },
        "release": {
          "preflightWorkflow": "release-check.yml"
        }
      },
      "expect": {
        "platforms": [
          "windows",
          "linux",
          "macos"
        ]
      }
    },
    {
      "name": "no-declaration",
      "manifest": {
        "version": "0.1.0",
        "sha256": {}
      },
      "expect": {
        "platforms": [],
        "check": {
          "cargoWorkspaces": [
            "."
          ],
          "bun": false,
          "setup": null,
          "runIgnored": null
        }
      }
    },
    {
      "name": "cargo-workspace-root",
      "manifest": {
        "platforms": [
          "macos"
        ],
        "platformCheck": {
          "cargoWorkspace": "."
        },
        "release": {
          "preflightWorkflow": "ci.yml"
        }
      },
      "expect": {
        "platforms": [
          "macos"
        ]
      }
    },
    {
      "name": "multi-workspace-run-ignored",
      "manifest": {
        "platforms": [
          "linux",
          "macos"
        ],
        "platformCheck": {
          "cargoWorkspace": [
            "tools",
            "packages/cli"
          ],
          "bun": true,
          "setup": "./bin/ci-install --frozen-lockfile",
          "runIgnored": "kind(lib) | kind(bin)"
        },
        "release": {
          "preflightWorkflow": "platform-check.yml"
        }
      },
      "expect": {
        "platforms": [
          "linux",
          "macos"
        ],
        "check": {
          "cargoWorkspaces": [
            "tools",
            "packages/cli"
          ],
          "bun": true,
          "setup": "./bin/ci-install --frozen-lockfile",
          "runIgnored": "kind(lib) | kind(bin)"
        }
      }
    },
